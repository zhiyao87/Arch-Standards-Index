# ════════════════════════════════════════════════════════════════════
#  换行符（EOL）策略
#
#  为什么需要这个文件：
#    Windows 版 Git 安装时默认写入系统级 core.autocrlf=true，
#    它会在「检出/checkout」时把仓库里的 LF 转成本机 CRLF。
#    结果是：同一个文件在 Windows 工作区是 CRLF、在 Linux/CI 是 LF，
#    每次提交都产生满屏「整文件重写」的 diff 噪音，跨平台协作直接崩。
#
#    本文件优先级高于 core.autocrlf —— 只要仓库里有它，
#    换行符行为就由它说了算，跟你本机（乃至同事本机）的全局设置无关。
#
#  原则：仓库内一律 LF（跨平台安全），需要 CRLF 的单独开例外。
# ════════════════════════════════════════════════════════════════════

# 兜底：自动识别文本文件，检出时统一为 LF
* text=auto eol=lf


# ── 文本文件：显式声明，避免 Git 的内容嗅探误判为二进制 ──────────
*.py          text eol=lf
*.md          text eol=lf
*.markdown    text eol=lf
*.txt         text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.ini         text eol=lf
*.cfg         text eol=lf
*.svg         text eol=lf
LICENSE       text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf


# ── 说明：CSV 也走 LF ─────────────────────────────────────────────
# 曾经想给 CSV 开 CRLF 例外（迁就 Excel），实测反而会触发
#   "LF will be replaced by CRLF the next time Git touches it"
# 因为源 CSV 由编辑器写成 LF，与属性表里的 eol=crlf 打架。
# 而 Excel 的 CSV 解析器本来就能识别 CR / LF / CRLF 三种行分隔，
# 真正的兼容性关键在编码（BOM），不在换行符 —— 所以统一 LF 最省事。
*.csv         text eol=lf


# ── 例外：Windows 脚本保留 CRLF ──────────────────────────────────
# cmd.exe / PowerShell 对 LF 结尾的批处理有时会出怪问题，保持原样。
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf


# ── 二进制文件：禁止任何换行符转换 ───────────────────────────────
*.pdf    binary
*.xlsx   binary
*.docx   binary
*.pptx   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.zip    binary
*.7z     binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary


# ── GitHub 语言统计 ──────────────────────────────────────────────
# 索引内容不是代码，不计入仓库语言占比（否则会显示成 100% Markdown）
*.md            linguist-documentation
obsidian/**     linguist-documentation
data/*.csv      linguist-documentation
